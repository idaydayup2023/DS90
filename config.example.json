{
  "ftp": {
    "host": "127.0.0.1",
    "port": 21,
    "username": "user",
    "password": "pass",
    "root_path": "/Downloads",
    "concurrency": 4
  },
  "paths": {
    "local_cache_dir": "./.cache/srt_translate",
    "state_db_path": "./.cache/srt_translate/state.sqlite3"
  },
  "video": {
    "extensions": [".mkv", ".mp4", ".avi", ".mov", ".m4v", ".ts"],
    "min_bytes": 52428800
  },
  "llm": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "translategemma:latest",
    "timeout_seconds": 300,
    "temperature": 0.2
  },
  "whisper": {
    "enabled": true,
    "command": ["whisper"],
    "language": "en",
    "asr_workers": 1,
    "auto_install": true,
    "device": "auto",
    "model": "small",
    "fallback_models": ["medium"],
    "task": "transcribe",
    "temperature": 0.0,
    "no_speech_threshold": 0.6
  },
  "pgs_ocr": {
    "enabled": true,
    "auto_install": true,
    "languages": ["en"],
    "max_workers": 1,
    "keep_temp_files": false
  },
  "translation": {
    "workers": 1,
    "batch_size": 20,
    "max_retries": 2
  },
  "dir_migrate": {
    "source": {
      "kind": "ftp",
      "root_path": "/Downloads"
    },
    "dest": {
      "kind": "ftp",
      "root_path": "/"
    },
    "subtitle": {
      "extensions": [".srt", ".ass", ".ssa", ".vtt"]
    },
    "rules": {
      "movie_1080_root": "X-Movie",
      "movie_4k_root": "MOVIE",
      "tv_1080_root": "X-TV",
      "tv_4k_root": "TV",
      "year_split": 2024,
      "franchise_map": {
        "NCIS: Miami": "NCIS",
        "NCIS: New Orleans": "NCIS"
      }
    },
    "execution": {
      "dry_run": true,
      "apply": false,
      "limit": 50,
      "workers": 2,
      "on_conflict": "skip"
    },
    "imdb": {
      "enabled": false,
      "auto_install": true,
      "ttl_days": 30,
      "min_rating": 5.0,
      "min_votes": null,
      "skip_unrated": true,
      "use_llm_judge": false
    },
    "cleanup": {
      "enabled": true,
      "protected_dirnames": ["torrent.files"],
      "min_confidence": 0.85,
      "delete_residual_files": true
    }
  }
}
